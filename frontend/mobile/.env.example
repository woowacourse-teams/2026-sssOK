# 기본값은 운영 웹입니다. 실제 기기에서 localhost 대신 개발 PC의 LAN 주소를 사용하세요.
EXPO_PUBLIC_WEB_URL=https://www.ssssok.com/home

# 기본은 development(dev 파일), 운영 설정은 APP_ENV=production
APP_ENV=development
# 아래 경로는 firebase/ 기본 파일 대신 다른 파일을 사용할 때만 지정하세요.
# GOOGLE_SERVICES_INFO_PLIST=./GoogleService-Info.dev.plist
# GOOGLE_SERVICES_JSON=./google-services.dev.json
