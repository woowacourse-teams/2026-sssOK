# Copy to .env on the host. Never commit the filled file or token files.
GALLERY_IMAGE=registry.example.com/sssok/gallery-mcp@sha256:REPLACE_WITH_VERIFIED_DIGEST
GALLERY_DATA_DIR=/home/ec2-user/sssok-mcp/gallery/data
GALLERY_MODELS_DIR=/home/ec2-user/sssok-mcp/gallery/models
GALLERY_TOKEN_PATH=/home/ec2-user/sssok-mcp/gallery/secrets/gallery_token
GALLERY_BACKEND_TOKEN_PATH=/home/ec2-user/sssok-mcp/gallery/secrets/backend_token
GALLERY_DOWNLOAD_HOSTS=REPLACE_ACCOUNT.r2.cloudflarestorage.com
# Explicit standalone mode is for EC2 analysis verification before Spring exists.
GALLERY_STANDALONE=true
GALLERY_BACKEND_URL=

# Shared DEV/PROD mode: Compose derives the container secret path from this host path.
# Fill environments.example.json with four distinct secrets (>=32 characters).
# GALLERY_ENVIRONMENTS_PATH=/home/ec2-user/sssok-mcp/gallery/secrets/environments.json
# GALLERY_STANDALONE=false
# With this file set, legacy GALLERY_TOKEN/BACKEND_URL/BACKEND_TOKEN are ignored.
