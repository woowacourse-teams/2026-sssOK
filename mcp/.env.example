# Copy to .env; generate a unique token with: openssl rand -hex 32
GALLERY_TOKEN=
GALLERY_MODELS_DIR=/absolute/path/to/prepared-models
# Exact storage hosts only; no scheme, wildcard or path.
GALLERY_DOWNLOAD_HOSTS=<ACCOUNT_ID>.r2.cloudflarestorage.com
GALLERY_ALLOWED_HOSTS=127.0.0.1:*,localhost:*

# Spring fixed internal endpoint. It must commit the result before acknowledging.
GALLERY_BACKEND_URL=
GALLERY_BACKEND_TOKEN=
# Explicitly set true only for standalone analysis tests without Spring.
GALLERY_STANDALONE=false
