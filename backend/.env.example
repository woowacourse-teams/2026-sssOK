# 이 파일을 .env 로 복사한 뒤 값을 채운다.
#   cp .env.example .env
#
# .env 는 docker-compose 가 자동으로 읽는다.
# 애플리케이션(application-local.yml)은 OS 환경변수를 읽으므로,
# 기본값과 다른 값을 쓸 때만 셸에 export 하거나 IDE 실행 구성에 등록한다.

# --- PostgreSQL ---
DB_NAME=sssok
DB_USERNAME=sssok
DB_PASSWORD=sssok
DB_PORT=5432

# --- JWT ---
# HS256 은 최소 256bit(32byte) 키를 요구한다.
# 생성 예: openssl rand -base64 32
JWT_SECRET=

# --- Cloudflare R2 ---
# 계정 ID 는 Cloudflare 대시보드 > R2 에서 확인한다.
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=sssok-dev
R2_PUBLIC_BASE_URL=

# #460 이미지 검색. 실제 키·샘플 임계값을 준비한 뒤 활성화한다.
IMAGE_SEARCH_ENABLED=false
OPENAI_API_KEY=
# 최초 기능 도입 시각(UTC ISO-8601)을 고정한다.
MEDIA_SEARCH_CREATED_SINCE=
# 실제 사진·검색어 샘플 평가 후 -1~1 범위로 지정한다.
MEDIA_SEARCH_QUERY_MIN_SIMILARITY=
