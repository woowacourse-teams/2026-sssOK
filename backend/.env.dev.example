# dev 서버의 배포 디렉터리(예: /home/ubuntu/app)에 `.env`로 복사해 값을 채운다.
#   cp .env.dev.example .env && chmod 600 .env
#
# 이 파일은 dev 서버에서 최초 1회만 만들면 되고, 배포할 때 CI가 덮어쓰지 않는다.
# 이미지 태그는 CI가 image.env에 따로 기록한다 (커밋 해시 기준, 운영처럼 릴리즈 태그 아님).

# --- PostgreSQL ---
# 운영과 같은 RDS 인스턴스를 쓰되, 데이터베이스 이름만 dev용으로 분리한다.
DB_URL=jdbc:postgresql://<rds-endpoint>:5432/sssok_dev
DB_USERNAME=sssok
DB_PASSWORD=

# --- JWT ---
# 운영과 다른 값을 쓴다 — dev에서 발급한 토큰이 운영에서 통하면 안 된다.
# 생성: openssl rand -base64 32
JWT_SECRET=

# --- Cloudflare R2 ---
# 운영(sssok-prod)과 분리된 dev 전용 버킷(sssok-dev)을 쓴다.
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=sssok-dev
R2_PUBLIC_BASE_URL=

# --- CORS ---
# dev 프론트(또는 로컬 프론트 개발 서버)가 이 dev 백엔드를 호출할 오리진.
# 콤마로 여러 개 지정 가능.
CORS_ALLOWED_ORIGINS=
