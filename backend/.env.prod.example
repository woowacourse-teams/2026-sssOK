# 운영 서버의 배포 디렉터리(예: /home/ubuntu/app)에 `.env` 로 복사해 값을 채운다.
#   cp .env.prod.example .env && chmod 600 .env
#
# 이 파일은 서버에서 최초 1회만 만들면 되고, 배포할 때 CI가 덮어쓰지 않는다.
# 이미지 태그는 CI가 image.env 에 따로 기록한다.

# --- PostgreSQL (RDS) ---
DB_URL=jdbc:postgresql://<rds-endpoint>:5432/sssok
DB_USERNAME=sssok
DB_PASSWORD=

# --- JWT ---
# 생성: openssl rand -base64 32
JWT_SECRET=

# --- Cloudflare R2 ---
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=sssok-prod
R2_PUBLIC_BASE_URL=

# --- CORS ---
# 브라우저에서 API를 호출할 프론트 오리진. 콤마로 여러 개 지정 가능 (예: https://sssok.com,https://www.sssok.com)
CORS_ALLOWED_ORIGINS=

# --- Discord ---
# 새 의견 알림을 받을 채널의 웹훅 URL. 비워 두면 알림 없이 동작한다.
# 채널 설정 > 연동 > 웹후크에서 만든다. URL 만으로 누구나 글을 쓸 수 있으니 외부에 노출하지 않는다.
DISCORD_FEEDBACK_WEBHOOK_URL=

# #460 이미지 검색. 실제 키·샘플 임계값을 준비한 뒤 활성화한다.
IMAGE_SEARCH_ENABLED=false
OPENAI_API_KEY=
# 최초 기능 도입 시각(UTC ISO-8601)을 고정한다.
MEDIA_SEARCH_CREATED_SINCE=
# 실제 사진·검색어 샘플 평가 후 -1~1 범위로 지정한다.
MEDIA_SEARCH_QUERY_MIN_SIMILARITY=
