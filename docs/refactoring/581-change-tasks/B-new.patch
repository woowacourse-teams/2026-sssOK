@@ -0,0 +1,35 @@
+package com.sssok.renewal.application.download.shared;
+
+import static org.assertj.core.api.Assertions.assertThatThrownBy;
+
+import com.sssok.renewal.application.download.exception.DownloadMediaNotFoundException;
+import com.sssok.renewal.application.download.exception.TooManyDownloadFilesException;
+import com.sssok.support.PostgresContainerSupport;
+import com.sssok.support.PostgresIntegrationTest;
+import java.util.List;
+import org.junit.jupiter.api.Test;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.test.context.TestPropertySource;
+
+@PostgresIntegrationTest
+@TestPropertySource(properties = "download.max-targets=2")
+class DownloadTargetLimitTest extends PostgresContainerSupport {
+
+    @Autowired
+    DownloadTargetResolver downloadTargetResolver;
+
+    @Test
+    void 설정한_상한을_넘으면_예외() {
+        assertThatThrownBy(() -> downloadTargetResolver.resolve(
+            new DownloadTargetCommand(1L, 1L, List.of(1L, 2L, 3L), null, null)))
+            .isInstanceOf(TooManyDownloadFilesException.class)
+            .hasMessageContaining("2개");
+    }
+
+    @Test
+    void 설정한_상한까지는_상한_예외가_아니다() {
+        assertThatThrownBy(() -> downloadTargetResolver.resolve(
+            new DownloadTargetCommand(1L, 1L, List.of(999_998L, 999_999L), null, null)))
+            .isInstanceOf(DownloadMediaNotFoundException.class);
+    }
+}
