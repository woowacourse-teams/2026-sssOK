diff --git a/backend/src/test/java/com/sssok/application/download/DownloadTargetLimitTest.java b/backend/src/test/java/com/sssok/application/download/DownloadTargetLimitTest.java
new file mode 100644
index 00000000..9a62aabd
--- /dev/null
+++ b/backend/src/test/java/com/sssok/application/download/DownloadTargetLimitTest.java
@@ -0,0 +1,33 @@
+package com.sssok.application.download;
+
+import static org.assertj.core.api.Assertions.assertThatThrownBy;
+
+import com.sssok.application.media.exception.MediaNotFoundException;
+import com.sssok.application.media.exception.TooManyMediaException;
+import com.sssok.support.PostgresContainerSupport;
+import com.sssok.support.PostgresIntegrationTest;
+import java.util.List;
+import org.junit.jupiter.api.Test;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.test.context.TestPropertySource;
+
+@PostgresIntegrationTest
+@TestPropertySource(properties = "download.max-targets=2")
+class DownloadTargetLimitTest extends PostgresContainerSupport {
+
+    @Autowired
+    DownloadTargetResolver downloadTargetResolver;
+
+    @Test
+    void 설정한_상한을_넘으면_예외() {
+        assertThatThrownBy(() -> downloadTargetResolver.resolve(1L, List.of(1L, 2L, 3L), null, 1L, null))
+            .isInstanceOf(TooManyMediaException.class)
+            .hasMessageContaining("2개");
+    }
+
+    @Test
+    void 설정한_상한까지는_상한_예외가_아니다() {
+        assertThatThrownBy(() -> downloadTargetResolver.resolve(1L, List.of(999_998L, 999_999L), null, 1L, null))
+            .isInstanceOf(MediaNotFoundException.class);
+    }
+}
