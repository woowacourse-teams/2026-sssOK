diff --git a/backend/src/test/java/com/sssok/renewal/application/download/zip/SweepDownloadJobsBatchSizeTest.java b/backend/src/test/java/com/sssok/renewal/application/download/zip/SweepDownloadJobsBatchSizeTest.java
new file mode 100644
index 00000000..f033bd9b
--- /dev/null
+++ b/backend/src/test/java/com/sssok/renewal/application/download/zip/SweepDownloadJobsBatchSizeTest.java
@@ -0,0 +1,60 @@
+package com.sssok.renewal.application.download.zip;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+import com.sssok.domain.file.StorageKey;
+import com.sssok.renewal.domain.download.DownloadJob;
+import com.sssok.renewal.domain.download.status.ExpiredDownloadJobStatus;
+import com.sssok.renewal.domain.download.status.ReadyDownloadJobStatus;
+import com.sssok.renewal.outgoing.database.DownloadJobRepository;
+import com.sssok.renewal.outgoing.storage.FileStorage;
+import com.sssok.support.H2IntegrationTest;
+import java.time.Duration;
+import java.time.Instant;
+import org.junit.jupiter.api.Test;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.test.context.TestPropertySource;
+import org.springframework.test.context.bean.override.mockito.MockitoBean;
+import org.springframework.transaction.annotation.Transactional;
+
+@H2IntegrationTest
+@Transactional
+@TestPropertySource(properties = "download.sweep-batch-size=2")
+class SweepDownloadJobsBatchSizeTest {
+
+    @Autowired
+    SweepDownloadJobsService sweepDownloadJobsService;
+
+    @Autowired
+    DownloadJobRepository downloadJobRepository;
+
+    @MockitoBean
+    FileStorage fileStorage;
+
+    private DownloadJob readyJobAt(Instant readyAt) {
+        DownloadJob job = DownloadJob.create(1L, 100L, 1, 1024L, "sssOK_1.zip", Instant.now());
+        job.markRunning();
+        job.markReady(new StorageKey("rooms/1/downloads/" + System.nanoTime() + ".zip"), readyAt);
+        return downloadJobRepository.save(job);
+    }
+
+    @Test
+    void 한_회차에는_설정한_수만큼_오래된_것부터_정리하고_나머지는_다음_회차로_넘긴다() {
+        Instant now = Instant.now();
+        DownloadJob newest = readyJobAt(now.minus(Duration.ofHours(2)));
+        DownloadJob oldest = readyJobAt(now.minus(Duration.ofHours(4)));
+        DownloadJob middle = readyJobAt(now.minus(Duration.ofHours(3)));
+
+        assertThat(sweepDownloadJobsService.sweepExpired(now)).isEqualTo(2);
+        assertThat(statusOf(oldest)).isEqualTo(ExpiredDownloadJobStatus.INSTANCE);
+        assertThat(statusOf(middle)).isEqualTo(ExpiredDownloadJobStatus.INSTANCE);
+        assertThat(statusOf(newest)).isEqualTo(ReadyDownloadJobStatus.INSTANCE);
+
+        assertThat(sweepDownloadJobsService.sweepExpired(now)).isEqualTo(1);
+        assertThat(statusOf(newest)).isEqualTo(ExpiredDownloadJobStatus.INSTANCE);
+    }
+
+    private Object statusOf(DownloadJob job) {
+        return downloadJobRepository.findById(job.getId()).orElseThrow().getStatus();
+    }
+}
